// Worker configuration. This file is the single source of truth for how
// www.asymptora.com is served; the Cloudflare dashboard is not edited by hand.
// Reference: https://developers.cloudflare.com/workers/wrangler/configuration/
{
  "$schema": "node_modules/wrangler/config-schema.json",

  // Worker name in the Cloudflare account. Also becomes the preview hostname:
  // https://www.asymptora.workers.dev
  "name": "www",

  // Pins runtime behaviour to this date so future platform changes cannot
  // silently alter how the site is served. Bump deliberately, in its own PR.
  "compatibility_date": "2026-09-12",

  // No Worker script: Cloudflare serves the directory below directly.
  "assets": {
    "directory": "./public",
    // Unknown paths get public/404.html with a real 404 status
    // (RFC 0001, goal "a real 404 for unknown paths").
    "not_found_handling": "404-page"
  },

  // Disabled after the custom domain cutover (RFC 0001, issue #14):
  // production runs on www.asymptora.com, and keeping workers.dev active
  // would leave a second, indexable public URL for the same site.
  "workers_dev": false,

  // No per-version preview URLs. With this on, a deployed version had a public
  // address of the form <version>-www.asymptora.workers.dev that served the
  // whole site, without Access (observed 2026-10-11, RFC 0003). The pipeline
  // never uses them (no step uploads a version to check before promoting it),
  // so they were a second public URL for nothing. Turn this on only together
  // with Cloudflare Access on the previews, and say why in an ADR.
  "preview_urls": false
}
